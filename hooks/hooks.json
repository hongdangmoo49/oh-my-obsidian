{
  "description": "Claude automatic summary guidance and quiet save verification",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugins/oh-my-obsidian/hooks/codex-hook-runner.mjs\" session-start --claude", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugins/oh-my-obsidian/hooks/codex-hook-runner.mjs\" user-prompt-submit --claude", "timeout": 10 }] }],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/plugins/oh-my-obsidian/hooks/codex-hook-runner.mjs\" stop --claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
